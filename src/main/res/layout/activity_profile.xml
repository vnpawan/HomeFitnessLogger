<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212"
    tools:ignore="HardcodedText,Autofill">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="USER PROFILE"
        android:textColor="#00B0FF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etAge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Age (Years)"
        android:inputType="number"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00B0FF"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etGender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Gender (Male / Female)"
        android:inputType="text"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00B0FF"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etWeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Weight (kg)"
        android:inputType="numberDecimal"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00B0FF"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etHeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Height (cm)"
        android:inputType="numberDecimal"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00B0FF"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI COACH CONFIG"
        android:textColor="#9C27B0"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etSuperGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Super Goal (e.g., Run a 5k without stopping)"
        android:inputType="textMultiLine"
        android:lines="3"
        android:gravity="top|start"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:backgroundTint="#9C27B0"
        android:layout_marginBottom="32dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SAVE PROFILE"
        android:textColor="#121212"
        android:textStyle="bold"
        app:backgroundTint="#00E676" />

</LinearLayout>